{
	"$schema": "vscode://schemas/color-theme",
	"name": "Orbyte Horizon Dark",
	"include": "./dark_modern.json",
	"type": "dark",
	"colors": {
		"foreground": "#D8E7F2",
		"descriptionForeground": "#8299AA",
		"focusBorder": "#2DD4D7",
		"icon.foreground": "#9AB8C9",
		"textLink.foreground": "#46B9E8",
		"textLink.activeForeground": "#5EE5DF",
		"button.background": "#4451C7",
		"button.foreground": "#FFFFFF",
		"button.hoverBackground": "#5664DF",
		"dropdown.background": "#101D2C",
		"dropdown.border": "#294158",
		"input.background": "#091420",
		"input.border": "#294158",
		"input.foreground": "#D8E7F2",
		"input.placeholderForeground": "#6F8798",
		"list.activeSelectionBackground": "#17394A",
		"list.activeSelectionForeground": "#FFFFFF",
		"list.inactiveSelectionBackground": "#142A38",
		"list.hoverBackground": "#2DD4D71A",
		"list.focusOutline": "#2DD4D7",
		"activityBar.background": "#07121E",
		"activityBar.foreground": "#DFFBFF",
		"activityBar.inactiveForeground": "#91B4C4",
		"activityBar.activeBackground": "#1B3645",
		"activityBar.activeBorder": "#2DD4D7",
		"activityBar.border": "#142536",
		"activityBarBadge.background": "#2DD4D7",
		"activityBarBadge.foreground": "#06131C",
		"modernActivityBarItem.activeBackground": "#1A4150",
		"modernActivityBarItem.activeForeground": "#F0FFFF",
		"modernActivityBarItem.hoverBackground": "#142D3A",
		"modernActivityBarItem.hoverForeground": "#D8F5F4",
		"sideBar.background": "#0B1724",
		"sideBar.foreground": "#B7D9E3",
		"sideBar.border": "#1A2B3C",
		"sideBarTitle.foreground": "#DFFBFF",
		"sideBarSectionHeader.background": "#101E2D",
		"sideBarSectionHeader.foreground": "#DFFBFF",
		"sideBarSectionHeader.border": "#213448",
		"titleBar.activeBackground": "#0A1623",
		"titleBar.activeForeground": "#DFFBFF",
		"titleBar.inactiveBackground": "#09131E",
		"titleBar.inactiveForeground": "#7196A8",
		"titleBar.border": "#1A2B3C",
		"menu.background": "#101D2C",
		"menu.foreground": "#D8E7F2",
		"menu.selectionBackground": "#17394A",
		"menu.selectionForeground": "#FFFFFF",
		"menu.separatorBackground": "#294158",
		"menu.border": "#294158",
		"commandCenter.background": "#091420",
		"commandCenter.border": "#294158",
		"editor.background": "#08121D",
		"editor.foreground": "#D8E7F2",
		"editorLineNumber.foreground": "#405B72",
		"editorLineNumber.activeForeground": "#8CCFFF",
		"editorCursor.foreground": "#2DD4D7",
		"editor.selectionBackground": "#17528A99",
		"editor.inactiveSelectionBackground": "#173E7066",
		"editor.lineHighlightBackground": "#0D1A27",
		"editorIndentGuide.background1": "#1C2D3E",
		"editorIndentGuide.activeBackground1": "#315B76",
		"editorWhitespace.foreground": "#27405A",
		"editorWidget.background": "#101D2C",
		"editorWidget.border": "#294158",
		"editorSuggestWidget.background": "#101D2C",
		"editorSuggestWidget.border": "#294158",
		"editorSuggestWidget.selectedBackground": "#17394A",
		"editorHoverWidget.background": "#101D2C",
		"editorHoverWidget.border": "#294158",
		"editorGroupHeader.tabsBackground": "#0B1724",
		"editorGroupHeader.connectedTabsBackground": "#0B1724",
		"editorGroupHeader.tabsBorder": "#1A2B3C",
		"tab.activeBackground": "#08121D",
		"tab.activeForeground": "#FFFFFF",
		"tab.inactiveBackground": "#0B1724",
		"tab.inactiveForeground": "#86A9B8",
		"tab.activeBorderTop": "#2DD4D7",
		"tab.border": "#1A2B3C",
		"panel.background": "#0B1724",
		"panel.border": "#1A2B3C",
		"panelTitle.activeBorder": "#2DD4D7",
		"panelTitle.activeForeground": "#FFFFFF",
		"panelTitle.inactiveForeground": "#86A9B8",
		"statusBar.background": "#26369B",
		"statusBar.foreground": "#DFFBFF",
		"statusBar.border": "#172578",
		"progressBar.background": "#2DD4D7",
		"extensionButton.prominentBackground": "#4451C7",
		"extensionButton.prominentHoverBackground": "#5664DF",
		"notificationCenterHeader.background": "#101A38",
		"notifications.background": "#101A38",
		"notifications.border": "#274069",
		"badge.background": "#17277D",
		"badge.foreground": "#DFFBFF",
		"gitDecoration.modifiedResourceForeground": "#159DFF",
		"gitDecoration.addedResourceForeground": "#43F1C8",
		"gitDecoration.deletedResourceForeground": "#FF6B68",
		"gitDecoration.untrackedResourceForeground": "#43F1C8",
		"gitDecoration.conflictingResourceForeground": "#FFAD24",
		"editorGutter.modifiedBackground": "#159DFF",
		"editorGutter.addedBackground": "#43F1C8",
		"editorGutter.deletedBackground": "#FF6B68",
		"diffEditor.insertedLineBackground": "#124C4566",
		"diffEditor.insertedTextBackground": "#17786466",
		"diffEditor.removedLineBackground": "#5A263566",
		"diffEditor.removedTextBackground": "#8A344966",
		"peekView.border": "#17E9FF",
		"peekViewEditor.background": "#080D1F",
		"peekViewResult.background": "#101A38",
		"terminal.background": "#080D1F",
		"terminal.foreground": "#C9EAF2",
		"terminalCursor.foreground": "#17E9FF"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#668999", "fontStyle": "italic" }
		},
		{
			"scope": ["keyword", "storage", "storage.type", "storage.modifier"],
			"settings": { "foreground": "#17E9FF" }
		},
		{
			"scope": ["string", "string.quoted", "string.template"],
			"settings": { "foreground": "#43F1C8" }
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.character"],
			"settings": { "foreground": "#FFAD24" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
			"settings": { "foreground": "#8CCFFF" }
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": { "foreground": "#FFD166" }
		},
		{
			"scope": ["variable.parameter", "meta.parameters variable"],
			"settings": { "foreground": "#C9EAF2" }
		},
		{
			"scope": ["entity.name.tag", "support.constant"],
			"settings": { "foreground": "#20DCFF" }
		},
		{
			"scope": ["entity.other.attribute-name", "variable.other.property"],
			"settings": { "foreground": "#9FCCE0" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#FF6B68", "fontStyle": "underline" }
		}
	]
}
