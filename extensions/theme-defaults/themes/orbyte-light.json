{
	"$schema": "vscode://schemas/color-theme",
	"name": "Orbyte Horizon Light",
	"include": "./light_modern.json",
	"type": "light",
	"colors": {
		"foreground": "#10233D",
		"descriptionForeground": "#526D80",
		"focusBorder": "#078EA0",
		"icon.foreground": "#315D73",
		"textLink.foreground": "#006FC4",
		"textLink.activeForeground": "#004E9B",
		"button.background": "#4451B8",
		"button.foreground": "#FFFFFF",
		"button.hoverBackground": "#5664CB",
		"dropdown.background": "#FFFFFF",
		"dropdown.border": "#A9CFDF",
		"input.background": "#FFFFFF",
		"input.border": "#A9CFDF",
		"input.foreground": "#10233D",
		"input.placeholderForeground": "#668395",
		"list.activeSelectionBackground": "#B8E8F7",
		"list.activeSelectionForeground": "#07164F",
		"list.inactiveSelectionBackground": "#D9F1F8",
		"list.hoverBackground": "#17E9FF24",
		"list.focusOutline": "#159DFF",
		"activityBar.background": "#E7F0F4",
		"activityBar.foreground": "#07164F",
		"activityBar.inactiveForeground": "#456D7D",
		"activityBar.activeBackground": "#CDE9EA",
		"activityBar.activeBorder": "#078EA0",
		"activityBar.border": "#B7DCEB",
		"activityBarBadge.background": "#17277D",
		"activityBarBadge.foreground": "#FFFFFF",
		"modernActivityBarItem.activeBackground": "#B8E1E4",
		"modernActivityBarItem.activeForeground": "#083B48",
		"modernActivityBarItem.hoverBackground": "#D8ECEE",
		"modernActivityBarItem.hoverForeground": "#173F4D",
		"sideBar.background": "#F0F5F7",
		"sideBar.foreground": "#18364A",
		"sideBar.border": "#B7DCEB",
		"sideBarTitle.foreground": "#07164F",
		"sideBarSectionHeader.background": "#E7F0F4",
		"sideBarSectionHeader.foreground": "#10233D",
		"sideBarSectionHeader.border": "#B7DCEB",
		"titleBar.activeBackground": "#ECF4F6",
		"titleBar.activeForeground": "#07164F",
		"titleBar.inactiveBackground": "#EDF7FB",
		"titleBar.inactiveForeground": "#617E8E",
		"titleBar.border": "#B7DCEB",
		"menu.background": "#F7FCFF",
		"menu.foreground": "#10233D",
		"menu.selectionBackground": "#B8E8F7",
		"menu.selectionForeground": "#07164F",
		"menu.separatorBackground": "#B7DCEB",
		"menu.border": "#A9CFDF",
		"commandCenter.background": "#FFFFFF",
		"commandCenter.border": "#A9CFDF",
		"editor.background": "#FAFCFD",
		"editor.foreground": "#10233D",
		"editorLineNumber.foreground": "#7894A3",
		"editorLineNumber.activeForeground": "#006FC4",
		"editorCursor.foreground": "#17277D",
		"editor.selectionBackground": "#9CDAF099",
		"editor.inactiveSelectionBackground": "#C5EAF566",
		"editor.lineHighlightBackground": "#EAF6FB",
		"editorIndentGuide.background1": "#CFE3EC",
		"editorIndentGuide.activeBackground1": "#83B5C9",
		"editorWhitespace.foreground": "#B5CDD8",
		"editorWidget.background": "#FFFFFF",
		"editorWidget.border": "#A9CFDF",
		"editorSuggestWidget.background": "#FFFFFF",
		"editorSuggestWidget.border": "#A9CFDF",
		"editorSuggestWidget.selectedBackground": "#B8E8F7",
		"editorHoverWidget.background": "#FFFFFF",
		"editorHoverWidget.border": "#A9CFDF",
		"editorGroupHeader.tabsBackground": "#F0F5F7",
		"editorGroupHeader.connectedTabsBackground": "#F0F5F7",
		"editorGroupHeader.tabsBorder": "#B7DCEB",
		"tab.activeBackground": "#FAFCFD",
		"tab.activeForeground": "#07164F",
		"tab.inactiveBackground": "#F0F5F7",
		"tab.inactiveForeground": "#526D80",
		"tab.activeBorderTop": "#159DFF",
		"tab.border": "#B7DCEB",
		"panel.background": "#EDF8FC",
		"panel.border": "#B7DCEB",
		"panelTitle.activeBorder": "#159DFF",
		"panelTitle.activeForeground": "#07164F",
		"panelTitle.inactiveForeground": "#526D80",
		"statusBar.background": "#3544A8",
		"statusBar.foreground": "#FFFFFF",
		"statusBar.border": "#07164F",
		"progressBar.background": "#159DFF",
		"extensionButton.prominentBackground": "#17277D",
		"extensionButton.prominentHoverBackground": "#21409A",
		"notificationCenterHeader.background": "#E3F2FA",
		"notifications.background": "#F7FCFF",
		"notifications.border": "#A9CFDF",
		"badge.background": "#17277D",
		"badge.foreground": "#FFFFFF",
		"gitDecoration.modifiedResourceForeground": "#006FC4",
		"gitDecoration.addedResourceForeground": "#087F69",
		"gitDecoration.deletedResourceForeground": "#C62828",
		"gitDecoration.untrackedResourceForeground": "#087F69",
		"gitDecoration.conflictingResourceForeground": "#A65B00",
		"editorGutter.modifiedBackground": "#159DFF",
		"editorGutter.addedBackground": "#087F69",
		"editorGutter.deletedBackground": "#C62828",
		"diffEditor.insertedLineBackground": "#BDEBDD66",
		"diffEditor.insertedTextBackground": "#7FD3BC66",
		"diffEditor.removedLineBackground": "#F4C5CB66",
		"diffEditor.removedTextBackground": "#E999A666",
		"peekView.border": "#159DFF",
		"peekViewEditor.background": "#F7FCFF",
		"peekViewResult.background": "#EAF6FB",
		"terminal.background": "#F7FCFF",
		"terminal.foreground": "#10233D",
		"terminalCursor.foreground": "#17277D"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#617D8A", "fontStyle": "italic" }
		},
		{
			"scope": ["keyword", "storage", "storage.type", "storage.modifier"],
			"settings": { "foreground": "#006FAF" }
		},
		{
			"scope": ["string", "string.quoted", "string.template"],
			"settings": { "foreground": "#087F69" }
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.character"],
			"settings": { "foreground": "#A65B00" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
			"settings": { "foreground": "#175E9A" }
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": { "foreground": "#7D4F00" }
		},
		{
			"scope": ["variable.parameter", "meta.parameters variable"],
			"settings": { "foreground": "#10233D" }
		},
		{
			"scope": ["entity.name.tag", "support.constant"],
			"settings": { "foreground": "#007F9F" }
		},
		{
			"scope": ["entity.other.attribute-name", "variable.other.property"],
			"settings": { "foreground": "#315D73" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#C62828", "fontStyle": "underline" }
		}
	]
}
