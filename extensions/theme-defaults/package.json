{
  "name": "theme-defaults",
  "displayName": "%displayName%",
  "description": "%description%",
  "categories": [
    "Themes"
  ],
  "version": "10.0.0",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "*"
  },
  "contributes": {
    "configurationDefaults": {
      "workbench.colorTheme": "Orbyte IntelliJ Dark",
      "workbench.preferredDarkColorTheme": "Orbyte IntelliJ Dark",
      "workbench.preferredLightColorTheme": "Orbyte Light",
      "window.autoDetectColorScheme": true,
      "workbench.iconTheme": "vscode-modern-icons",
      "workbench.tree.renderIndentGuides": "always",
      "workbench.tree.indent": 12,
      "workbench.editor.enablePreview": true,
      "workbench.editor.enablePreviewFromQuickOpen": true,
      "workbench.editor.highlightModifiedTabs": true,
      "workbench.editor.decorations.badges": true,
      "workbench.editor.decorations.colors": true,
      "explorer.autoReveal": true,
      "explorer.compactFolders": false,
      "explorer.decorations.badges": true,
      "explorer.decorations.colors": true,
      "breadcrumbs.enabled": true,
      "breadcrumbs.filePath": "on",
      "breadcrumbs.symbolPath": "on",
      "outline.icons": true,
      "outline.problems.enabled": true,
      "outline.problems.badges": true,
      "outline.problems.colors": true,
      "problems.decorations.enabled": true,
      "editor.semanticHighlighting.enabled": true,
      "editor.stickyScroll.enabled": true,
      "editor.stickyScroll.defaultModel": "outlineModel",
      "editor.inlayHints.enabled": "on",
      "editor.codeLens": true,
      "editor.glyphMargin": true,
      "editor.folding": true,
      "editor.showFoldingControls": "mouseover",
      "editor.bracketPairColorization.enabled": true,
      "editor.guides.bracketPairs": "active",
      "editor.guides.highlightActiveBracketPair": true,
      "editor.renderWhitespace": "selection",
      "editor.rulers": [120],
      "editor.minimap.enabled": false,
      "editor.linkedEditing": true,
      "diffEditor.renderSideBySide": true,
      "diffEditor.codeLens": true,
      "scm.diffDecorations": "all",
      "scm.alwaysShowActions": true,
      "scm.alwaysShowRepositories": true,
      "scm.defaultViewMode": "tree",
      "scm.defaultViewSortKey": "path",
      "scm.inputMinLineCount": 2,
      "scm.inputMaxLineCount": 8,
      "scm.providerCountBadge": "auto",
      "scm.repositories.selectionMode": "single",
      "scm.showActionButton": true,
      "scm.showInputActionButton": true,
      "git.alwaysShowStagedChangesResourceGroup": true,
      "git.autofetch": true,
      "git.confirmSync": true,
      "git.enableSmartCommit": true,
      "git.smartCommitChanges": "tracked",
      "git.showPushSuccessNotification": true,
      "files.autoSave": "afterDelay",
      "files.autoSaveDelay": 1000,
      "[java]": {
        "editor.defaultFormatter": "redhat.java",
        "editor.formatOnType": true,
        "editor.semanticHighlighting.enabled": true,
        "editor.inlayHints.enabled": "on"
      },
      "java.configuration.updateBuildConfiguration": "interactive",
      "java.debug.settings.hotCodeReplace": "auto",
      "spring-boot.ls.problem.application-properties.enabled": true
    },
    "themes": [
      {
        "id": "Light 2026",
        "label": "%light2026ThemeLabel%",
        "uiTheme": "vs",
        "path": "./themes/2026-light.json"
      },
      {
        "id": "Dark 2026",
        "label": "%dark2026ThemeLabel%",
        "uiTheme": "vs-dark",
        "path": "./themes/2026-dark.json"
      },
      {
        "id": "Orbyte IntelliJ Dark",
        "label": "%orbyteIntellijDarkThemeLabel%",
        "uiTheme": "vs-dark",
        "path": "./themes/orbyte-intellij-dark.json"
      },
      {
        "id": "Orbyte Light",
        "label": "%orbyteLightThemeLabel%",
        "uiTheme": "vs",
        "path": "./themes/orbyte-light.json"
      },
      {
        "id": "Dark+",
        "label": "%darkPlusColorThemeLabel%",
        "uiTheme": "vs-dark",
        "path": "./themes/dark_plus.json"
      },
      {
        "id": "Dark Modern",
        "label": "%darkModernThemeLabel%",
        "uiTheme": "vs-dark",
        "path": "./themes/dark_modern.json"
      },
      {
        "id": "Light+",
        "label": "%lightPlusColorThemeLabel%",
        "uiTheme": "vs",
        "path": "./themes/light_plus.json"
      },
      {
        "id": "Light Modern",
        "label": "%lightModernThemeLabel%",
        "uiTheme": "vs",
        "path": "./themes/light_modern.json"
      },
      {
        "id": "Visual Studio Dark",
        "label": "%darkColorThemeLabel%",
        "uiTheme": "vs-dark",
        "path": "./themes/dark_vs.json"
      },
      {
        "id": "Visual Studio Light",
        "label": "%lightColorThemeLabel%",
        "uiTheme": "vs",
        "path": "./themes/light_vs.json"
      },
      {
        "id": "Default High Contrast",
        "label": "%hcColorThemeLabel%",
        "uiTheme": "hc-black",
        "path": "./themes/hc_black.json"
      },
      {
        "id": "Default High Contrast Light",
        "label": "%lightHcColorThemeLabel%",
        "uiTheme": "hc-light",
        "path": "./themes/hc_light.json"
      }
    ],
    "iconThemes": [
      {
        "id": "vs-minimal",
        "label": "%minimalIconThemeLabel%",
        "path": "./fileicons/vs_minimal-icon-theme.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode.git"
  }
}
