{
  "name": "orbyte-spring",
  "displayName": "Orbyte Applications and Frameworks",
  "description": "Framework-aware run, debug, compound microservice, Java enterprise deployment, and environment tooling for Java, JavaScript, Python, PHP, .NET, Go, Rust, Ruby, and C/C++.",
  "version": "1.2.0",
  "publisher": "orbyte",
  "license": "MIT",
  "engines": { "vscode": "^1.100.0" },
  "enabledApiProposals": ["contribTitleBar"],
  "categories": ["Programming Languages", "Debuggers", "Other"],
  "activationEvents": [
    "onCommand:orbyte.spring.createProject",
    "onCommand:orbyte.environment.configure",
    "onStartupFinished",
    "onLanguage:java",
    "onLanguage:kotlin",
    "onLanguage:groovy",
    "workspaceContains:**/pom.xml",
    "workspaceContains:**/build.gradle",
    "workspaceContains:**/build.gradle.kts",
    "workspaceContains:**/build.xml",
    "workspaceContains:**/ejb-jar.xml",
    "workspaceContains:**/application.xml",
    "onView:orbyteApplicationServers"
  ],
  "main": "./out/extension",
  "scripts": {
    "compile": "gulp compile-extension:orbyte-spring",
    "watch": "gulp watch-extension:orbyte-spring"
  },
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": { "supported": "limited", "restrictedConfigurations": ["orbyte.java.autoDetect"] }
  },
  "contributes": {
    "commands": [
      { "command": "orbyte.spring.createProject", "title": "New Spring Boot Project…", "category": "Orbyte", "icon": "$(symbol-class)" },
      { "command": "orbyte.spring.run", "title": "Run Detected Java Project", "category": "Orbyte", "icon": "$(run)" },
      { "command": "orbyte.spring.debug", "title": "Debug Detected Java Project", "category": "Orbyte", "icon": "$(debug-alt)" },
      { "command": "orbyte.spring.stop", "title": "Stop Running Java Project", "category": "Orbyte", "icon": "$(debug-stop)", "enablement": "orbyte.spring.applicationRunning" },
      { "command": "orbyte.spring.restart", "title": "Restart Running Java Project", "category": "Orbyte", "icon": "$(debug-restart)", "enablement": "orbyte.spring.applicationRunning" },
      { "command": "orbyte.hotReload.enable", "title": "Enable Hot Reload", "category": "Orbyte", "icon": "$(circle-slash)" },
      { "command": "orbyte.hotReload.disable", "title": "Disable Hot Reload", "category": "Orbyte", "icon": "$(flame)" },
      { "command": "orbyte.hotReload.toggle", "title": "Toggle Hot Reload", "category": "Orbyte", "icon": "$(flame)" },
      { "command": "orbyte.hotReload.now", "title": "Hot Reload Now", "category": "Orbyte", "icon": "$(sync)" },
      { "command": "orbyte.spring.build", "title": "Build Detected Java Project", "category": "Orbyte", "icon": "$(tools)" },
      { "command": "orbyte.spring.test", "title": "Test Detected Java Project", "category": "Orbyte", "icon": "$(beaker)" },
      { "command": "orbyte.spring.showProjectActions", "title": "Show Java Project Actions", "category": "Orbyte" },
      { "command": "orbyte.spring.refreshProjects", "title": "Refresh Java Project Detection", "category": "Orbyte", "icon": "$(refresh)" },
      { "command": "orbyte.environment.configure", "title": "Language Environment Setup…", "category": "Orbyte", "icon": "$(tools)" },
      { "command": "orbyte.java.configureJdk", "title": "Java SDK Setup…", "category": "Orbyte", "icon": "$(coffee)" },
      { "command": "orbyte.run.configure", "title": "Edit Run Configurations…", "category": "Orbyte", "icon": "$(settings-gear)" },
      { "command": "orbyte.run.select", "title": "Select Run Configuration…", "category": "Orbyte", "icon": "$(list-selection)" },
      { "command": "orbyte.run.runSelected", "title": "Run Selected Configuration", "category": "Orbyte", "icon": "$(run-all)" },
      { "command": "orbyte.run.debugSelected", "title": "Debug Selected Configuration", "category": "Orbyte", "icon": "$(debug-alt)" },
      { "command": "orbyte.run.stopSelected", "title": "Stop Selected Configuration", "category": "Orbyte", "icon": "$(debug-stop)", "enablement": "orbyte.run.applicationRunning" },
      { "command": "orbyte.run.runDetected", "title": "Run Detected Application", "category": "Orbyte", "icon": "$(run)" },
      { "command": "orbyte.run.debugDetected", "title": "Debug Detected Application", "category": "Orbyte", "icon": "$(debug-alt)" },
      { "command": "orbyte.run.refreshApplications", "title": "Refresh Application Detection", "category": "Orbyte", "icon": "$(refresh)" },
      { "command": "orbyte.enterprise.configureServer", "title": "Add Application Server…", "category": "Orbyte", "icon": "$(add)" },
      { "command": "orbyte.enterprise.refreshServers", "title": "Refresh Application Servers", "category": "Orbyte", "icon": "$(refresh)" },
      { "command": "orbyte.enterprise.startServer", "title": "Start Application Server", "category": "Orbyte", "icon": "$(play)" },
      { "command": "orbyte.enterprise.debugServer", "title": "Start Application Server in Debug Mode", "category": "Orbyte", "icon": "$(debug-alt)" },
      { "command": "orbyte.enterprise.attachDebugger", "title": "Attach Debugger to Application Server", "category": "Orbyte", "icon": "$(debug-alt)" },
      { "command": "orbyte.enterprise.stopServer", "title": "Stop Application Server", "category": "Orbyte", "icon": "$(debug-stop)" },
      { "command": "orbyte.enterprise.deploy", "title": "Build & Deploy Enterprise Java Project…", "category": "Orbyte", "icon": "$(cloud-upload)" }
    ],
    "menus": {
      "file/newFile": [
        { "command": "orbyte.spring.createProject", "group": "project@1" }
      ],
      "editor/title": [
        { "command": "orbyte.hotReload.disable", "when": "resourceScheme == file && orbyte.hotReload.enabled", "group": "navigation@0" },
        { "command": "orbyte.hotReload.enable", "when": "resourceScheme == file && !orbyte.hotReload.enabled", "group": "navigation@0" },
        { "command": "orbyte.environment.configure", "when": "resourceLangId == javascript || resourceLangId == javascriptreact || resourceLangId == typescript || resourceLangId == typescriptreact || resourceLangId == python || resourceLangId == c || resourceLangId == cpp || resourceLangId == csharp || resourceLangId == fsharp || resourceLangId == go || resourceLangId == rust || resourceLangId == php || resourceLangId == ruby", "group": "navigation@0" },
        { "command": "orbyte.java.configureJdk", "when": "resourceLangId == java || resourceLangId == kotlin || resourceLangId == groovy", "group": "navigation@0" },
        { "command": "orbyte.run.configure", "when": "resourceScheme == file && orbyte.run.applicationDetected", "group": "navigation@1" },
        { "command": "orbyte.run.runDetected", "when": "resourceScheme == file && orbyte.run.applicationDetected && !orbyte.run.applicationRunning", "group": "navigation@2" },
        { "command": "orbyte.run.debugDetected", "when": "resourceScheme == file && orbyte.run.applicationDetected && !orbyte.run.applicationRunning", "group": "navigation@3" },
        { "command": "orbyte.run.stopSelected", "when": "resourceScheme == file && orbyte.run.applicationRunning", "group": "navigation@2" }
      ],
      "titleBar": [
        { "command": "orbyte.run.configure", "when": "orbyte.run.applicationDetected", "group": "navigation@1" },
        { "command": "orbyte.run.runSelected", "when": "orbyte.run.applicationDetected && !orbyte.run.applicationRunning", "group": "navigation@2" },
        { "command": "orbyte.run.debugSelected", "when": "orbyte.run.applicationDetected && !orbyte.run.applicationRunning", "group": "navigation@3" },
        { "command": "orbyte.run.stopSelected", "when": "orbyte.run.applicationRunning", "group": "navigation@2" },
        { "command": "orbyte.hotReload.disable", "when": "orbyte.hotReload.enabled", "group": "navigation@5" },
        { "command": "orbyte.hotReload.enable", "when": "!orbyte.hotReload.enabled", "group": "navigation@5" }
      ],
      "explorer/context": [
        { "command": "orbyte.run.configure", "when": "orbyte.run.applicationDetected", "group": "orbyte@0" },
        { "command": "orbyte.run.runDetected", "when": "orbyte.run.applicationDetected && !orbyte.run.applicationRunning", "group": "orbyte@1" },
        { "command": "orbyte.run.debugDetected", "when": "orbyte.run.applicationDetected && !orbyte.run.applicationRunning", "group": "orbyte@2" },
        { "command": "orbyte.run.stopSelected", "when": "orbyte.run.applicationRunning", "group": "orbyte@1" },
        { "command": "orbyte.spring.build", "when": "orbyte.spring.projectDetected", "group": "orbyte@3" },
        { "command": "orbyte.spring.test", "when": "orbyte.spring.projectDetected", "group": "orbyte@4" }
      ],
      "commandPalette": [
        { "command": "orbyte.environment.configure" },
        { "command": "orbyte.spring.createProject" },
        { "command": "orbyte.spring.run", "when": "orbyte.spring.projectDetected" },
        { "command": "orbyte.spring.debug", "when": "orbyte.spring.projectDetected" },
        { "command": "orbyte.spring.stop", "when": "orbyte.spring.applicationRunning" },
        { "command": "orbyte.spring.restart", "when": "orbyte.spring.applicationRunning" },
        { "command": "orbyte.hotReload.toggle" },
        { "command": "orbyte.hotReload.now" },
        { "command": "orbyte.spring.build", "when": "orbyte.spring.projectDetected" },
        { "command": "orbyte.spring.test", "when": "orbyte.spring.projectDetected" },
        { "command": "orbyte.spring.showProjectActions", "when": "orbyte.spring.projectDetected" },
        { "command": "orbyte.spring.refreshProjects" },
        { "command": "orbyte.java.configureJdk" },
        { "command": "orbyte.run.configure" },
        { "command": "orbyte.run.select", "when": "orbyte.run.applicationDetected" },
        { "command": "orbyte.run.runSelected", "when": "orbyte.run.applicationDetected" },
        { "command": "orbyte.run.debugSelected", "when": "orbyte.run.applicationDetected" },
        { "command": "orbyte.run.stopSelected", "when": "orbyte.run.applicationRunning" },
        { "command": "orbyte.run.runDetected", "when": "orbyte.run.applicationDetected" },
        { "command": "orbyte.run.debugDetected", "when": "orbyte.run.applicationDetected" },
        { "command": "orbyte.run.refreshApplications" },
        { "command": "orbyte.enterprise.configureServer" },
        { "command": "orbyte.enterprise.refreshServers" },
        { "command": "orbyte.enterprise.startServer" },
        { "command": "orbyte.enterprise.debugServer" },
        { "command": "orbyte.enterprise.attachDebugger" },
        { "command": "orbyte.enterprise.stopServer" },
        { "command": "orbyte.enterprise.deploy" }
      ],
      "view/title": [
        { "command": "orbyte.enterprise.configureServer", "when": "view == orbyteApplicationServers", "group": "navigation@1" },
        { "command": "orbyte.enterprise.refreshServers", "when": "view == orbyteApplicationServers", "group": "navigation@2" }
      ]
    },
    "views": {
      "explorer": [
        { "id": "orbyteApplicationServers", "name": "Application Servers", "icon": "$(server-environment)" }
      ]
    },
    "taskDefinitions": [
      {
        "type": "orbyte-java",
        "required": ["action", "project"],
        "properties": {
          "action": { "type": "string", "enum": ["run", "build", "test", "hotReload"], "description": "The Java project action to execute." },
          "project": { "type": "string", "description": "Absolute path to the detected project root." }
        }
      },
      {
        "type": "orbyte-enterprise",
        "required": ["action"],
        "properties": {
          "action": { "type": "string", "enum": ["build", "start", "debug", "stop", "deploy"] },
          "server": { "type": "string", "enum": ["wildfly", "websphere"] },
          "project": { "type": "string" }
        }
      },
      {
        "type": "orbyte-application",
        "required": ["application", "mode"],
        "properties": {
          "application": { "type": "string", "description": "Absolute root path of the detected application." },
          "mode": { "type": "string", "enum": ["run", "debug"] }
        }
      }
    ],
    "configuration": {
      "title": "Orbyte Applications and Environments",
      "properties": {
        "orbyte.java.autoDetect": { "type": "boolean", "default": true, "description": "Automatically detect Java, Spring Boot, Quarkus, Micronaut, Helidon, Vert.x, Jakarta EE, Maven, Gradle, and Ant projects." },
        "orbyte.java.showStatusBar": { "type": "boolean", "default": true, "description": "Show the detected Java framework and build tool in the status bar." },
        "orbyte.java.jdkHome": { "type": "string", "default": "", "scope": "resource", "description": "Project JDK selected in the unified Java setup for build, run, test, and debug actions." },
        "orbyte.environment.autoDetect": { "type": "boolean", "default": true, "scope": "window", "description": "Automatically detect the active project language and prompt when its required SDK, runtime, interpreter, or compiler is missing." },
        "orbyte.environment.runtimePaths": { "type": "object", "default": {}, "scope": "machine-overridable", "additionalProperties": { "type": "string" }, "description": "Locally selected runtime, interpreter, and compiler executable paths by language." },
        "orbyte.environment.preferredVersions": { "type": "object", "default": {}, "scope": "machine-overridable", "additionalProperties": { "type": "string" }, "description": "Preferred SDK and runtime versions selected in the unified Environment Setup dialog." },
        "orbyte.environment.heapMb": { "type": "object", "default": {}, "scope": "machine-overridable", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 131072 }, "description": "Optional language-server heap limits in MB by language. Missing values use automatic sizing." },
        "orbyte.hotReload.enabled": { "type": "boolean", "default": true, "scope": "window", "description": "Automatically hot reload or restart the active application when a supported source file is saved." },
        "orbyte.hotReload.delay": { "type": "number", "default": 900, "minimum": 100, "maximum": 10000, "scope": "window", "description": "Debounce delay in milliseconds before hot reload runs after a file is saved." },
        "orbyte.hotReload.command": { "type": "string", "default": "", "scope": "resource", "description": "Optional workspace command used to reload a framework or server that is not already handled by Orbyte. Active debug sessions are restarted automatically when this is empty." },
        "orbyte.hotReload.enterpriseServer": { "type": "string", "default": "auto", "enum": ["auto", "wildfly", "websphere"], "scope": "resource", "description": "Application server used for automatic EJB, EAR, and WAR redeployment." },
        "orbyte.run.configurations": { "type": "array", "default": [], "scope": "window", "description": "Named single-application and compound Run Configurations managed by Orbyte.", "items": { "type": "object", "required": ["name", "applications"], "properties": { "name": { "type": "string" }, "applications": { "type": "array", "items": { "type": "string" } }, "programArgs": { "type": "object", "additionalProperties": { "type": "string" } }, "commandOverrides": { "type": "object", "additionalProperties": { "type": "string" } } } } },
        "orbyte.run.selectedConfiguration": { "type": "string", "default": "", "scope": "window", "description": "Name of the active Orbyte Run Configuration." },
        "orbyte.enterprise.projectServers": { "type": "object", "default": {}, "scope": "window", "additionalProperties": { "type": "string", "enum": ["wildfly", "websphere"] }, "description": "Application server selected for each enterprise project root." },
        "orbyte.enterprise.wildfly.home": { "type": "string", "default": "", "scope": "resource", "description": "JBoss EAP or WildFly installation directory containing bin/standalone." },
        "orbyte.enterprise.wildfly.debugPort": { "type": "number", "default": 8787, "minimum": 1, "maximum": 65535, "scope": "resource", "description": "JDWP debug port for JBoss EAP or WildFly." },
        "orbyte.enterprise.websphere.profile": { "type": "string", "default": "", "scope": "resource", "description": "IBM WebSphere traditional profile directory containing bin/startServer and bin/wsadmin." },
        "orbyte.enterprise.websphere.serverName": { "type": "string", "default": "server1", "scope": "resource", "description": "WebSphere application server name." },
        "orbyte.enterprise.websphere.debugPort": { "type": "number", "default": 7777, "minimum": 1, "maximum": 65535, "scope": "resource", "description": "JDWP port used when attaching the Java debugger to WebSphere." }
      }
    }
  },
  "devDependencies": { "@types/node": "24.x" },
  "repository": { "type": "git", "url": "https://github.com/microsoft/vscode.git" }
}
